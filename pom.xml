<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
    SPEC (Source of Truth):
    - Module: `com.sugarcoatlabs:persistence-engines-core` (`1.0.0-SNAPSHOT`), a pure-JDK 24 JPMS library and filtered TCK `test-jar`[cite: 5].
    - Boundaries: Zero compile/runtime dependencies; only JUnit 5 and AssertJ are allowed in `test` scope, and only `com/sugarcoatlabs/persistence/tck/**` is packaged into the `test-jar`[cite: 5].
    - Publishing: Deploys releases and snapshots to GitHub Packages at `https://maven.pkg.github.com/sugarcoat-labs` using server ID `github-sugarcoat-labs`.
    -->

    <!--
    =======================================================================
    TECHNICAL SPECIFICATION - PLUGGABLE MODULE & TCK EXPORTER
    =======================================================================
    Project Name : persistence-engines-core[cite: 5]
    Type         : Pluggable & Reusable JPMS JAR Module + TCK Test-JAR[cite: 5]
    Description  : Provides lightweight, high-performance, and thread-safe
    persistence engines for Hexagonal Architecture (without
    framework overhead), plus the portable Technology Compatibility Kit
    (TCK) for external database realizations[cite: 5].

    Architecture & Compliance Requirements:
    - Runtime Environment : Java 24+ (Strict minimum compiler compliance & JPMS)[cite: 5]
    - Framework Policy    : Heavy frameworks (Spring Boot, Micronaut, Quarkus)
      and external database drivers are explicitly excluded to eliminate runtime
      overhead[cite: 5].
    - Concurrency Model   : Virtual-thread-friendly striped ReentrantLock
      partitions and lock-free unmodifiable snapshots[cite: 5].
    - Dependency Policy   : ZERO compile/runtime dependencies. Only testing
      libraries (JUnit 5 & AssertJ) are permitted, and strictly restricted to
      <scope>test</scope> so the final production JAR remains 100% pure JDK[cite: 5].
    - TCK Export Policy   : Packages ONLY abstract contract test suites under
      `com/sugarcoatlabs/persistence/tck/**` into the published `test-jar`,
      excluding all pure-JDK-specific tests[cite: 5].
    - Local & Repository Publication:
      Run `mvn clean install` to build and publish both artifacts to the
      local Maven repository (`~/.m2/repository`), or `mvn -B -DskipTests deploy`
      in CI to publish to GitHub Packages:
        1. `persistence-engines-core-1.0.0-SNAPSHOT.jar` (Main JPMS module)[cite: 5]
        2. `persistence-engines-core-1.0.0-SNAPSHOT-tests.jar` (Filtered TCK)[cite: 5]
    =======================================================================
    -->

    <groupId>com.sugarcoatlabs</groupId>
    <artifactId>persistence-engines-core</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>persistence-engines-core</name>
    <description>A lightweight, high-performance, and zero-dependency Java core module providing thread-safe persistence engines for Hexagonal Architecture.</description>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <github.packages.url>https://maven.pkg.github.com/sugarcoat-labs</github.packages.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>github-sugarcoat-labs</id>
            <name>GitHub Packages - sugarcoat-labs</name>
            <url>${github.packages.url}</url>
        </repository>
        <snapshotRepository>
            <id>github-sugarcoat-labs</id>
            <name>GitHub Packages Snapshots - sugarcoat-labs</name>
            <url>${github.packages.url}</url>
        </snapshotRepository>
    </distributionManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <argLine>--add-opens com.sugarcoatlabs.persistence/com.sugarcoatlabs.persistence.tck=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>default-test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/sugarcoatlabs/persistence/tck/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[24,)</version>
                                </requireJavaVersion>
                                <bannedDependencies>
                                    <message>Keep persistence-engines-core free of heavy frameworks and external drivers.</message>
                                    <excludes>
                                        <exclude>org.springframework:*</exclude>
                                        <exclude>org.springframework.boot:*</exclude>
                                        <exclude>io.micronaut:*</exclude>
                                        <exclude>io.quarkus:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>